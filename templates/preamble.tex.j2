% ---------- Couleurs (identiques au Générateur de DAT) ----------
\definecolor{primary}{HTML}{1F3864}
\definecolor{accent}{HTML}{2E74B5}
\definecolor{lightbg}{HTML}{DDEBF7}
\definecolor{graytxt}{HTML}{595959}
\definecolor{placeholdercol}{HTML}{C00000}

% ---------- Titres (mêmes réglages que le Générateur de DAT) ----------
\titleformat{\chapter}[hang]{\Large\bfseries\color{primary}}{\thechapter.}{0.6em}{}
\titlespacing{\chapter}{0pt}{0pt}{1.2em}
\titleformat{\section}{\large\bfseries\color{accent}}{\thesection}{0.6em}{}
\titleformat{\subsection}{\normalsize\bfseries\color{graytxt}}{\thesubsection}{0.6em}{}
\setcounter{secnumdepth}{2}
\setcounter{tocdepth}{2}

% ---------- Commande pour placeholders (repli visible, jamais bloquant) ----------
\newcommand{\placeholder}[1]{\textit{\textcolor{placeholdercol}{[#1]}}\par\vspace{4pt}}

% ---------- En-tête / pied de page (logos client + intégrateur) ----------
\pagestyle{fancy}
\fancyhf{}
% \chapter réinitialise le style de page en "plain" sur sa première page
% (comportement standard de la classe report) : on force la conservation
% du style "fancy" (logos) sur cette page également.
\assignpagestyle{\chapter}{fancy}
\renewcommand{\headrulewidth}{0.4pt}
\BLOCK{ if client.logo_file }
\fancyhead[L]{\includegraphics[height=1.1cm]{\VAR{ client.logo_file }}}
\BLOCK{ else }
\fancyhead[L]{\small\bfseries\color{graytxt}\VAR{ client.name }}
\BLOCK{ endif }
\fancyhead[R]{\includegraphics[height=1.1cm]{\VAR{ integrator.logo_file }}}
% Le pied de page (nom prestataire + pagination) n'est activé qu'à partir
% du chapitre 1 : la page de garde, l'historique des révisions et le
% sommaire n'en ont pas (voir generate_pdf.py, assemblage du document).

% ---------- En-tête de tableau réutilisable ----------
\newcommand{\tblhead}[1]{\textcolor{white}{\textbf{#1}}}

\hypersetup{
  colorlinks=true,
  linkcolor=accent,
  citecolor=accent,
  urlcolor=accent,
  pdftitle={Prérequis techniques - \VAR{ client.name }},
  pdfauthor={\VAR{ auteur.nom }}
}

